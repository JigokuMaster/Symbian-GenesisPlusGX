#include "../inc/SDLLauncher.hrh"

TARGET		GenesisPlusGX.exe
TARGETTYPE      exe
CAPABILITY 	ReadUserData WriteUserData 
UID		0 KSDLAppLauncherUid


EPOCSTACKSIZE 0x14000
//           8MB     241MB
EPOCHEAPSIZE 8000000 252000000

#define USE_ESDL USE_ESDL

#ifdef USE_ESDL
MACRO USE_ESDL
#endif

MACRO OPENC
MACRO S60V3
MACRO SYMBIAN_DIRECT_AUDIO
MACRO LSB_FIRST

//MACRO USE_32BPP_RENDERING 
MACRO USE_16BPP_RENDERING 
//MACRO USE_LIBTREMOR 
MACRO USE_LIBVORBIS
//MACRO MAXROMSIZE=33554432 
MACRO MAXROMSIZE=0x800000 // 8MB 
//MACRO HAVE_OPLL_CORE 
//MACRO HAVE_YM3438_CORE 
MACRO ENABLE_SUB_68K_ADDRESS_ERROR_EXCEPTIONS
//MACRO USE_DYNAMIC_ALLOC 
//MACRO DISABLE_MANY_OGG_OPEN_FILES
MACRO HAVE_STB_TRUETYPE

OPTION GCCE -std=c99 -O6 -fomit-frame-pointer -Wall -Wno-strict-aliasing 

ALWAYS_BUILD_AS_ARM

SOURCEPATH ..\src
#ifdef USE_ESDL
SOURCE SDLAppLauncher.cpp
#else 
SOURCE sdlexe.cpp
#endif
SOURCE Emu.cpp 
SOURCE EmuUtils.cpp
SOURCE DirectAudioStream.cpp
SOURCE SdlUiToolkit.cpp 
SOURCE blitter.c


SOURCEPATH ../src/Genesis-Plus-GX-master/core

SOURCE sound/ym2612.c
//SOURCE sound/opll.c
SOURCE sound/psg.c
SOURCE sound/sound.c
SOURCE sound/ym2413.c
SOURCE sound/blip_buf.c
SOURCE sound/eq.c
SOURCE m68k/s68kcpu.c
SOURCE m68k/m68kcpu.c
SOURCE system.c
SOURCE vdp_ctrl.c
SOURCE cart_hw/svp/ssp16.c
SOURCE cart_hw/svp/svp.c
SOURCE cart_hw/ggenie.c
SOURCE cart_hw/eeprom_93c.c
SOURCE cart_hw/sms_cart.c
SOURCE cart_hw/sram.c


SOURCE cart_hw/flash_cfi.c
SOURCE cart_hw/yx5200.c
SOURCE cart_hw/areplay.c
SOURCE cart_hw/eeprom_spi.c
SOURCE cart_hw/eeprom_i2c.c
SOURCE input_hw/gamepad.c
SOURCE input_hw/xe_1ap.c
SOURCE input_hw/terebi_oekaki.c
SOURCE input_hw/smash.c
SOURCE input_hw/activator.c
SOURCE input_hw/input.c
SOURCE input_hw/graphic_board.c
SOURCE input_hw/mouse.c
SOURCE input_hw/sportspad.c
SOURCE input_hw/teamplayer.c
SOURCE input_hw/paddle.c
SOURCE input_hw/lightgun.c
SOURCE loadrom.c
SOURCE vdp_render.c
SOURCE io_ctrl.c
SOURCE state.c
SOURCE membnk.c

#ifdef ENABLE_SEGACD
SOURCE sound/ym3438.c
SOURCE cart_hw/megasd.c
SOURCE cart_hw/md_cart.c
SOURCE cd_hw/cdc.c
SOURCE cd_hw/cd_cart.c
SOURCE cd_hw/pcm.c
SOURCE cd_hw/gfx.c
SOURCE cd_hw/cdd.c
SOURCE cd_hw/scd.c
SOURCE ntsc/md_ntsc.c
#endif

SOURCE ntsc/sms_ntsc.c
SOURCE mem68k.c
SOURCE memz80.c
SOURCE z80/z80.c
SOURCE genesis.c

SOURCEPATH ../src/Genesis-Plus-GX-master/sdl
SOURCE config.c  fileio.c error.c unzip.c

SOURCEPATH	..\data
START RESOURCE	GenesisPlusGX.rss
HEADER
TARGETPATH	\resource\apps
END


SOURCEPATH	..\data
START RESOURCE	GenesisPlusGX_reg.rss
#ifdef winscw
targetpath	\private\10003a3f\apps
#else
targetpath	\private\10003a3f\import\apps
#endif
END //resource

SYSTEMINCLUDE	\epoc32\include
SYSTEMINCLUDE	\epoc32\include\stdapis

#ifdef USE_ESDL
SYSTEMINCLUDE	\epoc32\include\ESDL
#else
SYSTEMINCLUDE	\epoc32\include\SDL
#endif

SYSTEMINCLUDE	\epoc32\include\vorbis
USERINCLUDE ../inc
USERINCLUDE ../src/Genesis-Plus-GX-master/core
USERINCLUDE ../src/Genesis-Plus-GX-master/core/z80 
USERINCLUDE ../src/Genesis-Plus-GX-master/core/m68k 
USERINCLUDE ../src/Genesis-Plus-GX-master/core/sound
USERINCLUDE ../src/Genesis-Plus-GX-master/core/sound/minimp3
USERINCLUDE ../src/Genesis-Plus-GX-master/core/sound/tremor
USERINCLUDE ../src/Genesis-Plus-GX-master/core/input_hw
USERINCLUDE ../src/Genesis-Plus-GX-master/core/cart_hw 
USERINCLUDE ../src/Genesis-Plus-GX-master/core/cart_hw/svp
USERINCLUDE ../src/Genesis-Plus-GX-master/core/cd_hw 
USERINCLUDE ../src/Genesis-Plus-GX-master/core/ntsc
USERINCLUDE ../src/Genesis-Plus-GX-master/sdl
USERINCLUDE ../src/Genesis-Plus-GX-master/sdl/sdl1
USERINCLUDE ../src

LIBRARY		euser.lib fbscli.lib ws32.lib  gdi.lib
LIBRARY		mediaclientaudiostream.lib

LIBRARY        avkon.lib efsrv.lib bafl.lib apparc.lib apgrfx.lib 
LIBRARY        eikcore.lib form.lib eikcoctl.lib eikdlg.lib cone.lib 
LIBRARY       commonengine.lib bitgdi.lib scdv.lib hal.lib flogger.lib

LIBRARY   libc.lib
LIBRARY	  libm.lib
LIBRARY	  libz.lib

#ifdef USE_ESDL
STATICLIBRARY 	ESDL.lib
#else
STATICLIBRARY 	SDL.lib
#endif
#ifdef ENABLE_SEGACDA
STATICLIBRARY vorbis.lib ogg.lib
#endif

